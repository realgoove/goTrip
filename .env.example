# Google Maps API - https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ODsay 한국 공공교통 API (무료) - https://lab.odsay.com
ODSAY_API_KEY=

# Google OAuth - https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel KV (optional) - Vercel 대시보드에서 KV 생성 후 env pull 로 자동 추가됨
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
